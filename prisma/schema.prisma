datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SubscriberPaymentInfo {
  id                    Int      @id @default(autoincrement())
  referenceId         String   @unique @default(uuid())
  userId                String
  email                 String?
  phone                 String?
  country               String?
  address               String?
  cvcEncrypted          String   
  expirationEncrypted   String   
  cardEncrypted         String   
  maskedCardNumber      String   
  maskedExpirationYear  String   
  fullName              String?
  createdAt             DateTime @default(now())
}

model BusinessDetails {
  id              Int       @id @default(autoincrement())
  bizId           String    @unique                      // tie back to your Mongo Biz._id
  bizName         String
  state           String
  fullAddress     String
  contactNumber   String
  categories      String[]                            // e.g. ["Construction","Repair"]
  servicesOffered String[]                            // e.g. ["Plumbing","Drains"]
  keywords        String[]
  description     String
  emailAddress    String
  otherWebsites   String[]                            // e.g. ["https://foo.com","https://bar.com"]
  officeHours     String[]                            // e.g. ["Mon 8:00 AM - 5:00 PM","Sun Closed"]
  images          String[]                            // your uploadBizImagesUrl array
  iconUrl         String                              // uploadBizIconUrl
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
