datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model SubscriberPaymentInfo {
  id                    Int      @id @default(autoincrement())
  referenceId         String   @unique @default(uuid())
  userId                String
  email                 String?
  phone                 String?
  country               String?
  address               String?
  cvcEncrypted          String   
  expirationEncrypted   String   
  cardEncrypted         String   
  maskedCardNumber      String   
  maskedExpirationYear  String   
  fullName              String?
  createdAt             DateTime @default(now())
}

model BusinessDetails {
  id              Int       @id @default(autoincrement())
  bizId           String                                
  version         Int       @default(1)                  

   bizName         String
   state           String
   fullAddress     String
   contactNumber   String
   categories      String[]                           
   servicesOffered String[]                          
   keywords        String[]
   description     String
   emailAddress    String
   otherWebsites   String[]                           
   officeHours     String[]                            
   images          String[]                            
   iconUrl         String                             

   createdAt       DateTime  @default(now())
   updatedAt       DateTime  @updatedAt
}